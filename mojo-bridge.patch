new file mode 100644
index 0000000..2d10ab5
--- /dev/null
+++ b/crates/exa-udf-runtime/src/c_ctx.rs
@@ -0,0 +1,438 @@
+//! C-ABI context bridge for non-Rust UDF `.so` files (e.g. Mojo).
+//!
+//! The stock UDF↔host contract passes `run` an opaque `ctx: *mut c_void` that is
+//! really a double-indirected `&mut dyn UdfContext` (see
+//! [`crate::dispatch::invoke_run`]). A Rust `.so` restores it and calls the trait
+//! methods directly, but a foreign-language `.so` cannot: the trait vtable and
+//! the [`Value`] enum are Rust-only. This module exports plain `extern "C"`
+//! accessors over the *same* opaque pointer so a Mojo (or C) `.so` can read
+//! inputs and write outputs.
+//!
+//! # Pointer contract
+//! Every `p: *mut c_void` here is exactly the pointer the host passes to
+//! `vtable.run`: `&mut (&mut dyn UdfContext)` erased to `*mut c_void`. The
+//! accessors undo the double-indirection identically to the generated run shim.
+//! The pointer is valid only for the duration of the `run` call it was handed to;
+//! a UDF must not retain it. All UDF calls are serialised on one thread, so the
+//! `thread_local!` emit buffer below needs no synchronisation.
+//!
+//! # Return codes
+//! `0` = ok; `1` = type mismatch / invalid UTF-8 / illegal operation for this
+//! context. Getters report SQL NULL through a separate `is_null` out-parameter
+//! rather than a return code.
+//!
+//! # Linking
+//! These symbols must land in the host binary's dynamic symbol table so the
+//! `dlopen`ed `.so` can resolve them. Because they live in this rlib and nothing
+//! in the host references them, call [`anchor`] once from `exaudfclient`'s `main`
+//! (behind the same feature) to defeat archive/GC stripping, and link the binary
+//! with `-C link-arg=-rdynamic` (see the patch notes). Alternatively, compile
+//! this module into a companion `cdylib` that both the host and the `.so` link.
+
+#[cfg(test)]
+use crate::rowset::HostContextBridge;
+use exasol_udf_sdk::context::UdfContext;
+use exasol_udf_sdk::value::Value;
+use std::cell::RefCell;
+use std::ffi::{c_char, c_void};
+
+/// Restore `&mut dyn UdfContext` from the opaque double-indirected pointer.
+///
+/// # Safety
+/// `p` must be the `*mut c_void` the host passed to `vtable.run` for the
+/// currently executing call (a live `*mut &mut dyn UdfContext`).
+#[inline]
+unsafe fn ctx<'a>(p: *mut c_void) -> &'a mut dyn UdfContext {
+    // Identical cast to `dispatch::invoke_run`: `p` points at a
+    // `&mut dyn UdfContext`; dereference the outer reference to get it back.
+    *unsafe { &mut *(p as *mut &mut dyn UdfContext) }
+}
+
+// ===========================================================================
+// Input side
+// ===========================================================================
+
+/// Number of input columns for the current call.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_num_columns(p: *mut c_void) -> usize {
+    unsafe { ctx(p) }.num_columns()
+}
+
+/// Read column `col` as `i64`. `*is_null` is set to `1` for SQL NULL else `0`;
+/// `*out` is written only when non-null. Returns `1` on a type mismatch.
+///
+/// # Safety
+/// `out` and `is_null` must be valid, writable pointers; see the module contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_get_i64(
+    p: *mut c_void,
+    col: usize,
+    out: *mut i64,
+    is_null: *mut i32,
+) -> i32 {
+    match unsafe { ctx(p) }.get_i64(col) {
+        Ok(None) => {
+            unsafe { *is_null = 1 };
+            0
+        }
+        Ok(Some(v)) => {
+            unsafe {
+                *is_null = 0;
+                *out = v;
+            }
+            0
+        }
+        Err(_) => 1,
+    }
+}
+
+/// Read column `col` as `f64`. See [`exa_ctx_get_i64`] for the out-param protocol.
+///
+/// # Safety
+/// `out` and `is_null` must be valid, writable pointers; see the module contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_get_f64(
+    p: *mut c_void,
+    col: usize,
+    out: *mut f64,
+    is_null: *mut i32,
+) -> i32 {
+    match unsafe { ctx(p) }.get_f64(col) {
+        Ok(None) => {
+            unsafe { *is_null = 1 };
+            0
+        }
+        Ok(Some(v)) => {
+            unsafe {
+                *is_null = 0;
+                *out = v;
+            }
+            0
+        }
+        Err(_) => 1,
+    }
+}
+
+/// Read column `col` as a boolean, returned as `0`/`1` in `*out`.
+///
+/// # Safety
+/// `out` and `is_null` must be valid, writable pointers; see the module contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_get_bool(
+    p: *mut c_void,
+    col: usize,
+    out: *mut i32,
+    is_null: *mut i32,
+) -> i32 {
+    match unsafe { ctx(p) }.get_bool(col) {
+        Ok(None) => {
+            unsafe { *is_null = 1 };
+            0
+        }
+        Ok(Some(v)) => {
+            unsafe {
+                *is_null = 0;
+                *out = v as i32;
+            }
+            0
+        }
+        Err(_) => 1,
+    }
+}
+
+/// Borrow column `col` as a UTF-8 string, returned as `(*out_ptr, *out_len)`.
+///
+/// The borrow points into host-owned memory and is valid only until the next
+/// accessor call on this context — the caller must copy it out immediately.
+/// `*is_null` is set to `1` for SQL NULL (pointer/len left untouched).
+///
+/// # Safety
+/// `out_ptr`, `out_len` and `is_null` must be valid, writable pointers; the
+/// returned pointer must not be used after the next accessor call.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_get_string(
+    p: *mut c_void,
+    col: usize,
+    out_ptr: *mut *const c_char,
+    out_len: *mut usize,
+    is_null: *mut i32,
+) -> i32 {
+    match unsafe { ctx(p) }.get_string(col) {
+        Ok(None) => {
+            unsafe { *is_null = 1 };
+            0
+        }
+        Ok(Some(s)) => {
+            unsafe {
+                *is_null = 0;
+                *out_ptr = s.as_ptr() as *const c_char;
+                *out_len = s.len();
+            }
+            0
+        }
+        Err(_) => 1,
+    }
+}
+
+/// Advance a SET-mode group to its next input row. `*has_next` is set to `1` when
+/// a row is now current, `0` at the group boundary. Returns `1` if the context is
+/// scalar (the host forbids `next()` there).
+///
+/// # Safety
+/// `has_next` must be a valid, writable pointer; see the module contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_next(p: *mut c_void, has_next: *mut i32) -> i32 {
+    match unsafe { ctx(p) }.next() {
+        Ok(more) => {
+            unsafe { *has_next = more as i32 };
+            0
+        }
+        Err(_) => 1,
+    }
+}
+
+// ===========================================================================
+// Output side — RETURNS shape (exactly one value per invocation)
+// ===========================================================================
+
+/// Set the single RETURNS output value to a `BIGINT`. Returns `1` if the context
+/// is not RETURNS-shaped.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_set_return_i64(p: *mut c_void, v: i64) -> i32 {
+    to_rc(unsafe { ctx(p) }.set_return(Some(Value::Int64(v))))
+}
+
+/// Set the single RETURNS output value to a `DOUBLE`.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_set_return_f64(p: *mut c_void, v: f64) -> i32 {
+    to_rc(unsafe { ctx(p) }.set_return(Some(Value::Double(v))))
+}
+
+/// Set the single RETURNS output value to a `BOOLEAN` (`v != 0`).
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_set_return_bool(p: *mut c_void, v: i32) -> i32 {
+    to_rc(unsafe { ctx(p) }.set_return(Some(Value::Bool(v != 0))))
+}
+
+/// Set the single RETURNS output value to a `VARCHAR` from a borrowed UTF-8
+/// buffer `(ptr, len)` (copied into an owned `String`). Returns `1` on invalid
+/// UTF-8 or a non-RETURNS context.
+///
+/// # Safety
+/// `ptr` must point to at least `len` readable bytes; see the module contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_set_return_string(
+    p: *mut c_void,
+    ptr: *const c_char,
+    len: usize,
+) -> i32 {
+    let bytes = unsafe { std::slice::from_raw_parts(ptr as *const u8, len) };
+    match std::str::from_utf8(bytes) {
+        Ok(s) => to_rc(unsafe { ctx(p) }.set_return(Some(Value::String(s.to_owned())))),
+        Err(_) => 1,
+    }
+}
+
+/// Set the single RETURNS output value to SQL NULL.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_set_return_null(p: *mut c_void) -> i32 {
+    to_rc(unsafe { ctx(p) }.set_return(None))
+}
+
+// ===========================================================================
+// Output side — EMITS shape (any number of multi-column rows)
+// ===========================================================================
+//
+// A row is assembled column-by-column into a thread-local buffer, then flushed
+// as one `ctx.emit(&[Value])`. Single-threaded execution makes the thread-local
+// safe and keeps the ABI free of a caller-managed row handle.
+
+thread_local! {
+    static EMIT_ROW: RefCell<Vec<Value>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Begin a fresh output row, clearing any partially-built one.
+///
+/// # Safety
+/// Trivially safe, but `extern "C"` for a uniform ABI; see the module contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_emit_row_reset(_p: *mut c_void) -> i32 {
+    EMIT_ROW.with(|r| r.borrow_mut().clear());
+    0
+}
+
+/// Append a `BIGINT` column to the current output row.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_emit_i64(_p: *mut c_void, v: i64) -> i32 {
+    EMIT_ROW.with(|r| r.borrow_mut().push(Value::Int64(v)));
+    0
+}
+
+/// Append a `DOUBLE` column to the current output row.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_emit_f64(_p: *mut c_void, v: f64) -> i32 {
+    EMIT_ROW.with(|r| r.borrow_mut().push(Value::Double(v)));
+    0
+}
+
+/// Append a `BOOLEAN` column (`v != 0`) to the current output row.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_emit_bool(_p: *mut c_void, v: i32) -> i32 {
+    EMIT_ROW.with(|r| r.borrow_mut().push(Value::Bool(v != 0)));
+    0
+}
+
+/// Append a `VARCHAR` column from a borrowed UTF-8 buffer `(ptr, len)`.
+/// Returns `1` on invalid UTF-8.
+///
+/// # Safety
+/// `ptr` must point to at least `len` readable bytes; see the module contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_emit_string(_p: *mut c_void, ptr: *const c_char, len: usize) -> i32 {
+    let bytes = unsafe { std::slice::from_raw_parts(ptr as *const u8, len) };
+    match std::str::from_utf8(bytes) {
+        Ok(s) => {
+            EMIT_ROW.with(|r| r.borrow_mut().push(Value::String(s.to_owned())));
+            0
+        }
+        Err(_) => 1,
+    }
+}
+
+/// Append a SQL NULL column to the current output row.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_emit_null(_p: *mut c_void) -> i32 {
+    EMIT_ROW.with(|r| r.borrow_mut().push(Value::Null));
+    0
+}
+
+/// Flush the assembled row via `ctx.emit(&[Value])` and clear the buffer.
+/// Returns `1` if emit fails (e.g. a RETURNS-shaped context) — the buffer is
+/// still cleared so a later row is not corrupted.
+///
+/// # Safety
+/// See the module-level pointer contract.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_ctx_emit_row_flush(p: *mut c_void) -> i32 {
+    let row = EMIT_ROW.with(|r| std::mem::take(&mut *r.borrow_mut()));
+    to_rc(unsafe { ctx(p) }.emit(&row))
+}
+
+// ===========================================================================
+// Error-string allocation
+// ===========================================================================
+
+/// Copy `(ptr, len)` into a fresh `malloc`ed, NUL-terminated C string and return
+/// it. The host takes ownership on the `run` error path and frees it with
+/// `libc::free` — the same C-allocator convention the Rust SDK uses for
+/// `error_out`, so the `.so`'s and host's allocators never mix. Returns null if
+/// `malloc` fails.
+///
+/// # Safety
+/// `ptr` must point to at least `len` readable bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn exa_alloc_cstring(ptr: *const c_char, len: usize) -> *mut c_char {
+    let buf = unsafe { libc::malloc(len + 1) } as *mut u8;
+    if buf.is_null() {
+        return std::ptr::null_mut();
+    }
+    unsafe {
+        std::ptr::copy_nonoverlapping(ptr as *const u8, buf, len);
+        *buf.add(len) = 0;
+    }
+    buf as *mut c_char
+}
+
+// ===========================================================================
+// GC anchor
+// ===========================================================================
+
+/// Reference every exported accessor so the linker cannot drop them from the
+/// host binary's symbol table. Call this once from `exaudfclient::main` (behind
+/// the `mojo-bridge` feature); the return value is opaque — `black_box` keeps the
+/// call from being optimised away. Not needed when the accessors are built into a
+/// companion `cdylib` instead.
+pub fn anchor() -> usize {
+    let fns: &[*const c_void] = &[
+        exa_ctx_num_columns as *const c_void,
+        exa_ctx_get_i64 as *const c_void,
+        exa_ctx_get_f64 as *const c_void,
+        exa_ctx_get_bool as *const c_void,
+        exa_ctx_get_string as *const c_void,
+        exa_ctx_next as *const c_void,
+        exa_ctx_set_return_i64 as *const c_void,
+        exa_ctx_set_return_f64 as *const c_void,
+        exa_ctx_set_return_bool as *const c_void,
+        exa_ctx_set_return_string as *const c_void,
+        exa_ctx_set_return_null as *const c_void,
+        exa_ctx_emit_row_reset as *const c_void,
+        exa_ctx_emit_i64 as *const c_void,
+        exa_ctx_emit_f64 as *const c_void,
+        exa_ctx_emit_bool as *const c_void,
+        exa_ctx_emit_string as *const c_void,
+        exa_ctx_emit_null as *const c_void,
+        exa_ctx_emit_row_flush as *const c_void,
+        exa_alloc_cstring as *const c_void,
+    ];
+    std::hint::black_box(fns.iter().map(|p| *p as usize).sum())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Compile-time proof that the accessor cast lines up with the real trait
+    /// object the host builds from [`crate::rowset::HostContextBridge`]: this
+    /// reproduces `dispatch::invoke_run`'s erasure, and `ctx()` reverses it.
+    #[allow(dead_code)]
+    fn bridge_erases_like_invoke_run(b: &mut HostContextBridge) -> *mut c_void {
+        let mut dyn_ref: &mut dyn UdfContext = &mut *b;
+        &mut dyn_ref as *mut &mut dyn UdfContext as *mut c_void
+    }
+
+    /// The emit row buffer accumulates columns and hands them over on flush.
+    #[test]
+    fn emit_row_buffer_accumulates_and_takes() {
+        EMIT_ROW.with(|r| r.borrow_mut().clear());
+        EMIT_ROW.with(|r| r.borrow_mut().push(Value::Int64(1)));
+        EMIT_ROW.with(|r| r.borrow_mut().push(Value::Null));
+        let row = EMIT_ROW.with(|r| std::mem::take(&mut *r.borrow_mut()));
+        assert_eq!(row, vec![Value::Int64(1), Value::Null]);
+        assert!(EMIT_ROW.with(|r| r.borrow().is_empty()));
+    }
+}
+
+#[inline]
+fn to_rc(r: Result<(), exasol_udf_sdk::error::UdfError>) -> i32 {
+    match r {
+        Ok(()) => 0,
+        Err(_) => 1,
+    }
+}

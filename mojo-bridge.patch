+/// Known non-Rust language tags for foreign UDF `.so` fingerprints. A Rust
+/// `.so` stamps `"<sdk_version>:<rustc_hash>"`; a foreign SDK stamps
+/// `"<lang>:<sdk_version>"` (e.g. `"mojo:0.1.0"`).
+#[cfg(feature = "mojo-bridge")]
+const FOREIGN_LANG_TAGS: &[&str] = &["mojo"];
+
+/// Validate a loaded `.so`'s SDK fingerprint against the host's.
+///
+/// The default rule is exact equality: a Rust `.so` must be built with the same
+/// SDK version and rustc as the host, because the `.so`'s and host's separately
+/// linked Rust runtimes must agree on `Value`/allocator layout across the
+/// boundary.
+///
+/// With the `mojo-bridge` feature, a fingerprint whose leading `:`-delimited tag
+/// names a known foreign language (e.g. `"mojo:0.1.0"`) bypasses the rustc-hash
+/// equality: such a `.so` links no Rust runtime and reaches the host only through
+/// the C-ABI accessor bridge (`crate::c_ctx`), so the rustc-hash guard is
+/// meaningless for it. The vtable's `abi_version` — already checked equal to
+/// [`EXA_UDF_ABI_VERSION`] before this call — stays the structural guarantee that
+/// the vtable layout matches. A Rust `.so`'s fingerprint also contains a `:`, but
+/// its leading tag is the SDK version (e.g. `"0.14.0"`), which is never in
+/// [`FOREIGN_LANG_TAGS`], so it still requires an exact match.
+fn validate_fingerprint(so_fp: &str, host_fp: &str) -> Result<(), RuntimeError> {
+    if so_fp == host_fp {
+        return Ok(());
+    }
+    #[cfg(feature = "mojo-bridge")]
+    if let Some((lang, _version)) = so_fp.split_once(':')
+        && FOREIGN_LANG_TAGS.contains(&lang)
+    {
+        tracing::debug!(
+            fingerprint = so_fp,
+            "accepting foreign-language UDF fingerprint (rustc-hash check waived)"
+        );
+        return Ok(());
+    }
+    Err(RuntimeError::FingerprintMismatch {
+        expected: host_fp.to_string(),
+        found: so_fp.to_string(),
+    })
+}

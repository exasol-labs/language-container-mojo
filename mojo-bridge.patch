@@ -0,0 +1,17 @@
+//! Under the `mojo-bridge` feature, export the binary's dynamic symbols so a
+//! `dlopen`ed non-Rust UDF `.so` can resolve the `exa_ctx_*` accessors defined
+//! in `exa-udf-runtime`. Without this, the accessors live in the binary but are
+//! not in its dynamic symbol table, and the `.so` fails to load with an
+//! undefined-symbol error. No-op unless the feature is on.
+
+fn main() {
+    if std::env::var_os("CARGO_FEATURE_MOJO_BRIDGE").is_some() {
+        // GNU ld / lld use `-rdynamic`; the macOS linker wants `-export_dynamic`.
+        // The production SLC target is Linux glibc; the macOS arm keeps local
+        // dev builds working.
+        match std::env::var("CARGO_CFG_TARGET_OS").as_deref() {
+            Ok("macos") => println!("cargo:rustc-link-arg-bins=-Wl,-export_dynamic"),
+            _ => println!("cargo:rustc-link-arg-bins=-rdynamic"),
+        }
+    }
+}

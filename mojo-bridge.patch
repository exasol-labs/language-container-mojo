+        # `ldd` of a real Mojo .so (docs/mojo-runtime.md).
+        find "$MODROOT" -name '*.so*' -exec cp -Lv {} /mojo-libs/ \; ; \
+        ls -1 /mojo-libs || { echo "error: no Mojo runtime .so staged from $MODROOT" >&2; exit 1; }; \
+    fi
+
